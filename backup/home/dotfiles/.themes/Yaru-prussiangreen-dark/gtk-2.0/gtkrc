style "sway-control-center" {
    fg[NORMAL] = "#f0f0f0"
    fg[ACTIVE] = "#f0f0f0"
    fg[PRELIGHT] = "#f0f0f0"
    fg[SELECTED] = "#ffffff"
    fg[INSENSITIVE] = "#a0a0a0"
    bg[NORMAL] = "#2d2d2d"
    bg[ACTIVE] = "#353535"
    bg[PRELIGHT] = "#353535"
    bg[SELECTED] = "#368582"
    bg[INSENSITIVE] = "#2d2d2d"
    base[NORMAL] = "#171717"
    base[ACTIVE] = "#2d2d2d"
    base[PRELIGHT] = "#353535"
    base[SELECTED] = "#368582"
    base[INSENSITIVE] = "#353535"
    text[NORMAL] = "#f0f0f0"
    text[ACTIVE] = "#f0f0f0"
    text[PRELIGHT] = "#f0f0f0"
    text[SELECTED] = "#ffffff"
    text[INSENSITIVE] = "#a0a0a0"
    engine "clearlooks" { colorize_scrollbar = TRUE }
}
class "*" style "sway-control-center"
