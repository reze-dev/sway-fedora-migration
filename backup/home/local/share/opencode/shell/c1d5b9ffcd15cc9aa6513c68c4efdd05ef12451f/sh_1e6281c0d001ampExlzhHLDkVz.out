=== strip_sway_wallpaper ===
def strip_sway_wallpaper(config_path):
    """Drop any "output * bg" line from the Sway config.

    Sway spawns swaybg itself for that directive, so leaving it in place would
    run swaybg next to awww and both would paint the background layer.
    """
    config_path = Path(config_path)
    if not config_path.exists():
        return
    lines = config_path.read_text().splitlines()
    updated = [line for line in lines if not re.match(r"^\s*output\s+\*\s+bg\s+", line)]
    if updated != lines:
        config_path.write_text("\n".join(updated).rstrip() + "\n")


def apply_wallpaper(settings):
