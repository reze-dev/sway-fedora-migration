292:( cd "$DEST" && find . -type f -not -path './archives/*' -not -name 'checksums.sha256' -print0 \
293:    | sort -z | xargs -0 sha256sum > checksums.sha256 )
296:    sha256sum "$f" >> ../checksums.sha256
298:date -Is > "$DEST/capture-date.txt"
301:    "$(sway --version 2>&1 | head -1)" > "$DEST/capture-meta.txt"
