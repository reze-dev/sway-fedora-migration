127:    --exclude='cache/' --exclude='Cache/' --exclude='GPUCache/' \
128:    --exclude='Code Cache/' --exclude='CachedData/' --exclude='cache2/' \
129:    --exclude='blob_storage/' --exclude='Crash Reports/' --exclude='*.log' \
130:    --exclude='mozilla/firefox/' --exclude='opencode/cli.json' \
131:    --exclude='opencode/service.json'
139:    --exclude='mise' --exclude='starship' --exclude='__pycache__'
141:    --exclude='containers/' --exclude='nvim/' --exclude='fonts/' \
142:    --exclude='opencode/opencode.db*' --exclude='opencode/snapshot/' \
143:    --exclude='opencode/log/' --exclude='gvfs-metadata/'
145:    --exclude='dnf5.log*'
151:copy_tree "$HOME_DIR/.cargo" "$DEST/home/cargo" --exclude='registry/' --exclude='git/'
152:copy_tree "$HOME_DIR/.rustup" "$DEST/home/rustup" --exclude='toolchains/' --exclude='downloads/'
153:copy_tree "$HOME_DIR/.var/app" "$DEST/home/var-app" --exclude='cache/'
